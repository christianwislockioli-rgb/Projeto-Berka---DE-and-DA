
# PostgreSQL (OLTP & Airflow Metadata)
POSTGRES_USER=berka_admin
POSTGRES_PASSWORD=changeme_secret_password
POSTGRES_DB=berka_oltp
POSTGRES_PORT=5432

# MongoDB (NoSQL - Logs e Eventos Semiestruturados)
MONGO_INITDB_ROOT_USERNAME=mongo_admin
MONGO_INITDB_ROOT_PASSWORD=changeme_mongo_password
MONGO_PORT=27017

# Apache Airflow
AIRFLOW_UID=50000
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# AWS / Databricks Cloud Integration
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=sua_access_key_aqui
AWS_SECRET_ACCESS_KEY=sua_secret_key_aqui
DATABRICKS_HOST=https://dbc-seu-workspace.cloud.databricks.com
DATABRICKS_TOKEN=dapi_seu_token_aqui